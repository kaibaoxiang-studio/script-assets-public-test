{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "DomainResultV1.schema.json",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "succeeded",
        "blocked",
        "failed"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "design_decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "knowledge_used": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "summary",
        "design_decisions",
        "unresolved",
        "knowledge_used"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "status",
    "result",
    "artifacts",
    "questions",
    "error"
  ],
  "additionalProperties": false
}
