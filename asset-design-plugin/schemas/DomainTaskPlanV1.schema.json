{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "DomainTaskPlanV1.schema.json",
  "type": "object",
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "enum": [
              "character",
              "scene",
              "prop"
            ]
          },
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "state_id": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "context": {
            "type": "object"
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "deliverables": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "skill": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "domain",
          "asset_id",
          "state_id",
          "objective"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "tasks"
  ],
  "additionalProperties": false
}
