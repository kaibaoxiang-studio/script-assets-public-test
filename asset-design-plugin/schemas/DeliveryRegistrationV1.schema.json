{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "DeliveryRegistrationV1.schema.json",
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "state_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "enum": [
        "character",
        "scene",
        "prop"
      ]
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "artifact_path": {
      "type": "string",
      "minLength": 1
    },
    "approval_record_path": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "asset_id",
    "state_id",
    "domain",
    "stage",
    "artifact_path",
    "approval_record_path",
    "task_id"
  ],
  "additionalProperties": false
}
