{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AssetProjectContextV1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AssetProjectContextV1"
    },
    "source_sha256": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "story_summary": {
      "type": "string",
      "minLength": 1
    },
    "world_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cross_asset_design": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "chunk_id": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "script_fact",
              "inference",
              "creative_choice",
              "unconfirmed_setting"
            ]
          }
        },
        "required": [
          "chunk_id",
          "observation",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "hidden_information": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "source_sha256",
    "coverage",
    "story_summary",
    "world_rules",
    "cross_asset_design",
    "evidence",
    "hidden_information"
  ],
  "additionalProperties": false
}
